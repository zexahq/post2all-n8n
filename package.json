{
	"name": "n8n-nodes-post2all",
	"version": "0.1.0",
	"description": "n8n community node for post2all: create, schedule, and publish social media posts, manage accounts, and react to publishing events.",
	"license": "MIT",
	"homepage": "https://www.post2all.com",
	"keywords": [
		"n8n-community-node-package",
		"post2all",
		"social media",
		"scheduling"
	],
	"author": {
		"name": "post2all",
		"email": "support@post2all.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zexahq/post2all-n8n.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/Post2allApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Post2all/Post2all.node.js",
			"dist/nodes/Post2allTrigger/Post2allTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.52.5",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
